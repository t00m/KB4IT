{
    "id": "techdoc",
    "name": "Techdoc",
    "version": "1.0.0",
    "author": "[Tomás Vírseda]",
    "email": "[tomasvirseda@gmail.com]",
    "website": "https://github.com/t00m/KB4IT",
    "description": "Theme for technical documentation",
    "search": true,
    "editor": true,
    "feed": false,
    "kb4it": ">=0.10.0",
    "favicon": "images/logo.svg",
    "autoescape": true,
    "template_base": "uikit",
    "toc_sidebar": false,
    "header_keys": {
        "badges": ["DocType", "Status", "Priority"],
        "links": ["Date", "WorkType", "Topic", "Product"]
    },
    "info_groups": [
        {"name": "Classification", "keys": ["DocType", "Category", "WorkType", "Topic", "Scope", "Handover"]},
        {"name": "Systems", "keys": ["Product", "SID", "Environment", "Database", "OS", "Stack", "Server", "Kernel"]},
        {"name": "Technical objects", "chips": true,
         "keys": ["Transaction", "Command", "Program", "Table", "Job", "RFC", "Component", "User", "Role", "Filesystem"]},
        {"name": "Organisation", "keys": ["Author", "Team", "Project", "Milestone", "Company"]},
        {"name": "Lifecycle", "keys": ["Status", "Priority", "Date", "Periodicity", "Public"]}
    ],
    "quality": {
        "tiers": {"exemplary": 75, "complete": 60, "basic": 40},
        "targets": {"How-to guide": 150, "Reference": 200, "Explanation": 500, "Tutorial": 800},
        "record_target": 60,
        "half_life": {"How-to guide": 3, "Tutorial": 3, "Reference": 4, "Explanation": 8},
        "final_status": ["Released", "Completed", "Finished", "Successful"],
        "retired_status": ["Obsolete", "Deprecated", "Withdrawn", "Rejected"],
        "known_values": {
            "Status": ["New", "Open", "Draft", "Planned", "Completed", "Released", "Finished", "Successful",
                       "Deprecated", "Obsolete", "Withdrawn", "Rejected"],
            "Priority": ["Critical", "Very high", "High", "Medium", "Normal", "Low"],
            "DocType": ["Tutorial", "How-to guide", "Reference", "Explanation"]
        }
    },
    "info_tabs": {
        "details": {"print": true},
        "quality": {"print": false},
        "related": {"print": false},
        "history": {"print": false}
    }
}
